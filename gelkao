#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$here/lib.sh"
# shellcheck source=volume.sh
source "$here/volume.sh"

DEFAULT_DRAW_PATH=data/volumes.webp

usage() {
  cat <<'EOF'
Usage:
  cat data/*.html | gelkao invoice audit - [-g "<project>"] [-d <dir>] [-f <path>]
                                     download the invoices on stdin, then audit them
  cat data/*.html | gelkao invoice list
                                     list the customer number and invoice UUIDs
  gelkao invoice fetch [-d <dir>]    download invoice CSVs (output of list on stdin)
  gelkao invoice audit [-g "<project>"] [-d <dir>] [-f <path>]
                                     audit the CSVs already in <dir>; stdin is never read

  -g "<project>"   audit only one Hetzner project (the invoice "grouping" column);
                   valid for audit only
  -d <dir>         CSV directory (default: data)
  -f <path>        database file (default: <dir>/gelkao.db)
  -q               skip the price-refresh prompt (non-interactive)

  cat volumes.txt | gelkao volume show
                                     draw the leaf / volume pool / volume tree from the
                                     placement table Hetzner support sends you
  cat volumes.txt | gelkao volume draw [-o <path>] [-t <volumes>]
                                     render the same placement as a treemap webp
                                     (default: data/volumes.webp)

  -t <volumes>     how many volumes you can afford to lose at once; a leaf or
                   volume group holding that many is drawn red (default: 20)

The customer number is read from the invoice page itself — there is nothing to type.
EOF
}

banner() {
  local b='' u='' r=''
  if [ -t 2 ]; then b=$'\e[1m'; u=$'\e[34m'; r=$'\e[0m'; fi
  printf '\n%sCloud Inefficiency Audit%s · %shttps://gelkao.com%s\n\n' "$b" "$r" "$u" "$r" >&2
}

cmd_list() { list_invoices "$@"; }

cmd_fetch() { fetch_all "$1"; }

cmd_audit() {
  local grouping=$1 quiet=$2 data_dir=$3 db=$4 from_stdin=${5:-}
  if [[ "$from_stdin" != "-" ]]; then
    audit "$here" "$data_dir" "$db" "$grouping" "$quiet"
    return
  fi
  banner
  run_pipeline "$here" "$data_dir" "$db" "$grouping" "$quiet"
}

invoice_cmd() {
  local verb=${1-}
  [[ -n "$verb" ]] || die "invoice needs a subcommand: list, fetch or audit"
  shift
  local from_stdin='' arg
  local -a args=()
  for arg in "$@"; do
    if [[ "$arg" = "-" ]]; then from_stdin='-'; else args+=("$arg"); fi
  done
  set -- ${args[@]+"${args[@]}"}
  local OPTIND grouping="" quiet=0 data_dir=data data_dir_set=0 db=""
  while getopts ":g:d:f:hq" opt; do
    case "$opt" in
      g) grouping=$OPTARG ;;
      d) data_dir=$OPTARG; data_dir_set=1 ;;
      f) db=$OPTARG ;;
      q) quiet=1 ;;
      h) usage; exit 0 ;;
      :) die "option -$OPTARG requires a value" ;;
      \?) die "unknown option: -$OPTARG" ;;
    esac
  done
  shift $((OPTIND - 1))
  case "$verb" in
    list)  [[ -z "$from_stdin" ]] || die "- is not valid for list; it always reads stdin";
           [[ -z "$grouping" ]] || die "-g is not valid for list"; [[ "$data_dir_set" = 0 ]] || die "-d is not valid for list"; [[ -z "$db" ]] || die "-f is not valid for list"; cmd_list "$@" ;;
    fetch) [[ -z "$from_stdin" ]] || die "- is not valid for fetch; it always reads stdin";
           [[ -z "$grouping" ]] || die "-g is not valid for fetch"; [[ -z "$db" ]] || die "-f is not valid for fetch"; cmd_fetch "$data_dir" ;;
    audit) [[ $# -eq 0 ]] || die "unexpected argument: $1 — use - to read the invoice page from stdin"
           cmd_audit "$grouping" "$quiet" "$data_dir" "$db" "$from_stdin" ;;
    *)     die "unknown invoice subcommand: $verb — try list, fetch or audit" ;;
  esac
}

volume_cmd() {
  local verb=${1-}
  [[ -n "$verb" ]] || die "volume needs a subcommand: show or draw"
  shift
  local OPTIND out="" tolerance=""
  while getopts ":o:t:h" opt; do
    case "$opt" in
      o) out=$OPTARG ;;
      t) tolerance=$OPTARG ;;
      h) usage; exit 0 ;;
      :) die "option -$OPTARG requires a value" ;;
      \?) die "unknown option: -$OPTARG" ;;
    esac
  done
  shift $((OPTIND - 1))
  [[ $# -eq 0 ]] || die "unexpected argument: $1"
  case "$verb" in
    show) [[ -z "$out" ]] || die "-o is not valid for show"
          [[ -z "$tolerance" ]] || die "-t is not valid for show"; volume_show "$here" ;;
    draw) volume_draw "$here" "${out:-$DEFAULT_DRAW_PATH}" "$tolerance" ;;
    *)    die "unknown volume subcommand: $verb - try show or draw" ;;
  esac
}

main() {
  case "${1-}" in
    '')           usage; exit 2 ;;
    --help|-h)    usage; exit 0 ;;
    invoice)      shift; invoice_cmd "$@" ;;
    volume)       shift; volume_cmd "$@" ;;
    *)            die "unknown command: $1 — try 'invoice', or --help" ;;
  esac
}

main "$@"
